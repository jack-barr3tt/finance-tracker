# Example systemd unit — copy to /etc/systemd/system/finance-tracker.service on the server.
# Adjust User, paths, and EnvironmentFile to match your deploy_path secret.

[Unit]
Description=Finance Tracker API
After=network.target postgresql.service

[Service]
Type=simple
User=deploy
WorkingDirectory=/opt/finance-tracker
EnvironmentFile=/opt/finance-tracker/.env
ExecStart=/opt/finance-tracker/finance-tracker
Restart=on-failure

[Install]
WantedBy=multi-user.target
